# Piper TTS service — development environment configuration
# Copy this file to .env.dev and fill in the values for your DEV environment.
# .env.dev is gitignored — never commit it.
#
# Required:
PIPER_MODEL_DIR=/path/to/voices   # directory containing .onnx voice model files

# Optional (defaults shown):
# PIPER_HOST=127.0.0.1
# PIPER_PORT=5002
# PIPER_DEFAULT_VOICE=en_US-lessac-medium
# PIPER_SAMPLE_RATE=8000
# PIPER_MAX_CONCURRENT=2
# PIPER_SYNTHESIS_TIMEOUT_SEC=30
# PIPER_MAX_TEXT_LENGTH=5000
# LOG_LEVEL=INFO

# ── Sentence pacing + voice tuning (defaults applied when a request omits them) ──
# PIPER_SENTENCE_SILENCE_MS — silence (milliseconds) inserted between each spoken
#   sentence/line. piper-tts 1.4.2 concatenates sentences with no gap and has no
#   native sentence_silence option, so the service inserts it. 0 = no added pause.
PIPER_SENTENCE_SILENCE_MS=350
# PIPER_LENGTH_SCALE — speaking rate (higher = slower). Unset = model default (~1.0).
# PIPER_LENGTH_SCALE=1.0
# PIPER_NOISE_SCALE — generation variability. Unset = model default (~0.667).
# PIPER_NOISE_SCALE=0.667
# PIPER_NOISE_W — phoneme-length variability (maps to piper-tts noise_w_scale).
#   Unset = model default (~0.8).
# PIPER_NOISE_W=0.8
